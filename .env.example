# ── AWS Bedrock (primary model provider) ──────────────────────────────────────
# Named profile in ~/.aws/config that has Bedrock permissions.
AWS_PROFILE=genai-agent-user
AWS_DEFAULT_REGION=us-east-1

# Corporate SSL interception: point at your org's CA bundle if Bedrock calls
# fail with certificate errors. Leave blank if not behind a proxy.
# SSL_CERT_FILE=/path/to/corp-ca-bundle.pem
# AWS_CA_BUNDLE=/path/to/corp-ca-bundle.pem
# REQUESTS_CA_BUNDLE=/path/to/corp-ca-bundle.pem

# ── Local Ollama endpoint ─────────────────────────────────────────────────────
# Used by local_fast (phi4-mini), local_standard (devstral), local_heavy
# (qwen3.6:35b) and the legacy private group. Must be a local endpoint.
OLLAMA_BASE_URL=http://localhost:11434

# ── LiteLLM gateway ───────────────────────────────────────────────────────────
LITELLM_CONFIG_PATH=config/litellm.config.yaml

# ── Langfuse observability ────────────────────────────────────────────────────
# These must be set before `docker compose up` — they seed the Langfuse
# project/user on first boot (see docker-compose.yml) and are also how this
# app authenticates to the Langfuse API. Any non-empty string works locally;
# generate with e.g. `openssl rand -hex 16`.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:13000
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_PASSWORD=
LANGFUSE_INIT_USER_NAME=Admin

# ── Postgres / pgvector ───────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_DB=governed_agent
POSTGRES_USER=governed_agent
# Required by docker-compose.yml — generate with e.g. `openssl rand -hex 32`.
POSTGRES_PASSWORD=

# ── Langfuse (nextauth) — required by docker-compose.yml ─────────────────────
# Generate with `openssl rand -hex 32` / `openssl rand -hex 16` respectively.
NEXTAUTH_SECRET=
SALT=

# ── Agent behaviour ───────────────────────────────────────────────────────────
# Default data class for tasks when not specified: public | internal | restricted
DEFAULT_DATA_CLASS=internal
