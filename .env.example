# ── Model providers (at least one required for non-private classes) ────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=

# ── Private / local model endpoint ────────────────────────────────────────────
# Used for "private" model group (data-class: restricted). Must never be external.
PRIVATE_MODEL_ENDPOINT=http://localhost:11434  # e.g. Ollama
PRIVATE_MODEL_NAME=llama3.2

# ── LiteLLM gateway ───────────────────────────────────────────────────────────
LITELLM_CONFIG_PATH=config/litellm.config.yaml

# ── Langfuse observability ────────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# ── Postgres / pgvector ───────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ust_agent
POSTGRES_USER=ust_agent
POSTGRES_PASSWORD=changeme

# ── Agent behaviour ───────────────────────────────────────────────────────────
# Default data class for tasks when not specified: public | internal | restricted
DEFAULT_DATA_CLASS=internal
