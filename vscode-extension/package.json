{
  "name": "ust-coding-agent",
  "displayName": "UST Coding Agent",
  "description": "AI coding assistant powered by the UST Coding Agent — terminal-native, HITL-aware, multi-model",
  "version": "0.2.0",
  "publisher": "ust",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": ["AI", "Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {

    "commands": [
      {
        "command": "ust-agent.openTerminal",
        "title": "UST Agent: Open Terminal",
        "icon": "$(terminal)"
      },
      {
        "command": "ust-agent.newSession",
        "title": "UST Agent: New Session",
        "icon": "$(add)"
      },
      {
        "command": "ust-agent.refreshSessions",
        "title": "UST Agent: Refresh Sessions",
        "icon": "$(refresh)"
      }
    ],

    "viewsContainers": {
      "activitybar": [
        {
          "id": "ust-agent-sidebar",
          "title": "UST Agent",
          "icon": "resources/icon.svg"
        }
      ]
    },

    "views": {
      "ust-agent-sidebar": [
        {
          "id": "ust-agent.chatView",
          "name": "Chat",
          "type": "webview"
        }
      ]
    },

    "menus": {
      "view/title": [
        {
          "command": "ust-agent.newSession",
          "when": "view == ust-agent.chatView",
          "group": "navigation@1"
        },
        {
          "command": "ust-agent.openTerminal",
          "when": "view == ust-agent.chatView",
          "group": "navigation@2"
        }
      ]
    },

    "configuration": {
      "title": "UST Coding Agent",
      "properties": {
        "ustAgent.binaryPath": {
          "type": "string",
          "default": "ust-agent",
          "description": "Path to the ust-agent binary (defaults to PATH lookup)"
        },
        "ustAgent.agentHome": {
          "type": "string",
          "default": "",
          "description": "UST_AGENT_HOME directory (leave blank to auto-detect)"
        },
        "ustAgent.dataClass": {
          "type": "string",
          "enum": ["public", "internal", "restricted"],
          "enumDescriptions": [
            "Data may be sent to external frontier models",
            "Data stays within approved enterprise APIs",
            "Strictly local models only — no external calls"
          ],
          "default": "internal",
          "description": "Data classification — controls which model groups are permitted"
        },
        "ustAgent.role": {
          "type": "string",
          "enum": ["planner", "codegen"],
          "default": "planner",
          "description": "Primary agent role"
        },
        "ustAgent.plannerModel": {
          "type": "string",
          "enum": ["cheap", "mid", "frontier", "local_fast", "local_standard", "local_heavy"],
          "enumDescriptions": [
            "Haiku — fastest, lowest cost",
            "Sonnet — balanced",
            "Sonnet 4.6 — highest quality",
            "phi4-mini — local, fast",
            "devstral — local, balanced",
            "qwen 35B — local, best quality"
          ],
          "default": "mid",
          "description": "Model group for the planner role"
        },
        "ustAgent.subagentModel": {
          "type": "string",
          "enum": ["cheap", "mid", "frontier", "local_fast", "local_standard", "local_heavy"],
          "default": "cheap",
          "description": "Model group for sub-agent roles (codegen, knowledge, summary, testing)"
        },
        "ustAgent.includeKnowledge": {
          "type": "boolean",
          "default": true,
          "description": "Include knowledge retrieval tool in each session"
        }
      }
    }
  },

  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "watch":   "tsc -watch -p tsconfig.json",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license"
  },

  "devDependencies": {
    "@types/node":   "^20.19.43",
    "@types/vscode": "^1.100.0",
    "typescript":    "^5.9.3"
  }
}
